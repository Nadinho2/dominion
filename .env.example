# ==============================================================================
# DOMINION INTERNATIONAL SCHOOL MANAGEMENT SYSTEM (DIS-SMS)
# Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION (User Management, RBAC & Identity)
# Get keys from: https://dashboard.clerk.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key_here

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------------------------
# 2. SUPABASE (PostgreSQL Database & Cloud Storage)
# Get keys from: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.sample_service_role_key

# Supabase Storage Buckets:
# - student-avatars (Public)
# - report-cards (Private/Authenticated)
# - bursary-receipts (Private/Authenticated)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_AVATARS=student-avatars
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_REPORTS=report-cards
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_RECEIPTS=bursary-receipts

# ------------------------------------------------------------------------------
# 3. RESEND (Mailing System & Notification Dispatcher)
# Get key from: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_sample_resend_api_key_here
RESEND_FROM_EMAIL=admissions@dominioninternational.sch.ng
RESEND_NOTIFICATION_EMAIL=info@dominioninternational.sch.ng

# ------------------------------------------------------------------------------
# 4. SCHOOL APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SCHOOL_NAME="Dominion International School"
NEXT_PUBLIC_SCHOOL_MOTTO="Dominion Through Excellence"
NEXT_PUBLIC_SCHOOL_ADDRESS="Plot 14/16 Airport Road, Ajao Estate, Ikeja, Lagos State, Nigeria"
NEXT_PUBLIC_APP_URL=http://localhost:3000

